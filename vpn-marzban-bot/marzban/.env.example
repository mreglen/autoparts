## Скопируйте в .env:  cp .env.example .env
## Замените пароли, IP и ключи Reality перед запуском.

# --- Админ панели (создаётся при первом старте, если заданы) ---
SUDO_USERNAME=admin
SUDO_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# --- Панель только на localhost (бот ходит сюда же) ---
# Не занимает 80/443. Для внешнего доступа используйте SSH-туннель:
#   ssh -L 62050:127.0.0.1:62050 user@YOUR_SERVER_IP
UVICORN_HOST=127.0.0.1
UVICORN_PORT=62050

# Путь к конфигу Xray внутри контейнера (volume /var/lib/marzban-vpn -> /var/lib/marzban)
XRAY_JSON=/var/lib/marzban/xray_config.json

# Префикс ссылок подписки. Подставьте публичный IP или домен.
# Если панель только на 127.0.0.1 — для клиентов нужен доступ к этому URL
# (откройте 62050 в firewall ИЛИ вынесите sub через отдельный порт/домен позже).
# Для локальной выдачи ключей ботом достаточно vless:// из поля links.
XRAY_SUBSCRIPTION_URL_PREFIX=http://YOUR_SERVER_IP:62050
XRAY_SUBSCRIPTION_PATH=sub

# SQL (по умолчанию SQLite в volume — ок для одного VPS)
# SQLALCHEMY_DATABASE_URL=sqlite:////var/lib/marzban/db.sqlite3
