[Unit]
Description=Public Marzban VPN Telegram bot (isolated)
# Telegram API на VPS часто только через Tor
After=network-online.target tor.service
Wants=network-online.target
Wants=tor.service

[Service]
Type=simple
User=marzbanbot
Group=marzbanbot
WorkingDirectory=/opt/marzban-vpn-bot
EnvironmentFile=/opt/marzban-vpn-bot/.env
ExecStart=/opt/marzban-vpn-bot/.venv/bin/python /opt/marzban-vpn-bot/main.py
Restart=always
RestartSec=5
# Безопасность: без лишних привилегий
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
