## Скопируйте:  cp .env.example .env
## Токен бота: @BotFather -> /newbot

BOT_TOKEN=123456:REPLACE_WITH_TELEGRAM_BOT_TOKEN
BOT_USERNAME=marzvpn_bot

# PostgreSQL (таблицы с префиксом marzvpn_)
# Можно использовать ту же БД, что и у сайта (autoparts)
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/autoparts

# Панель Marzban (на этом же VPS слушает только localhost:62050)
MARZBAN_BASE_URL=http://127.0.0.1:62050
MARZBAN_USERNAME=admin
MARZBAN_PASSWORD=CHANGE_ME_STRONG_PASSWORD

# Должен совпадать с tag inbound в xray_config.json
INBOUND_TAG=VLESS TCP REALITY

# Публичный rewrite subscription URL → HTTPS (Happ rejects http://IP:port)
SUB_URL_REWRITE_FROM=://195.24.65.251:62050
SUB_URL_REWRITE_TO=://svoygarage.ru

# Квоты: 0 GB = без лимита трафика
DATA_LIMIT_GB=50

# Тестовый период при /start: 10 минут = 10; 3 дня = 4320
TRIAL_MINUTES=4320
REFERRAL_REWARD_DAYS=5

# Прокси до api.telegram.org (на VPS в РФ обычно нужен Tor)
TELEGRAM_PROXY_URL=socks5://127.0.0.1:9050

# Celery (проверка подлинности ключей). Можно отдельная DB Redis, напр. /2
CELERY_BROKER_URL=redis://127.0.0.1:6379/2
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/2
KEY_VERIFY_INTERVAL_MINUTES=5
