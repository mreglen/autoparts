[Unit]
Description=MarzVPN bot Celery beat (periodic key verify)
After=network-online.target redis-server.service
Wants=network-online.target

[Service]
Type=simple
User=marzbanbot
Group=marzbanbot
WorkingDirectory=/opt/marzban-vpn-bot
EnvironmentFile=/opt/marzban-vpn-bot/.env
ExecStart=/opt/marzban-vpn-bot/.venv/bin/celery -A celery_app.celery_app beat -l INFO
Restart=always
RestartSec=5
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
