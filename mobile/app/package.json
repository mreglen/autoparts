{
  "name": "sg-autoservice",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "api:types": "npx --yes openapi-typescript@7.13.0 src/api/openapi.json -o src/api/schema.d.ts",
    "theme:sync": "node scripts/sync-theme.mjs",
    "theme:check": "node scripts/sync-theme.mjs --check",
    "export:android": "expo export --platform android"
  },
  "dependencies": {
    "@expo/vector-icons": "^15.0.2",
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-native-community/datetimepicker": "9.2.1",
    "@react-native-community/netinfo": "12.0.1",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.106.1",
    "babel-preset-expo": "~58.0.0",
    "expo": "~58.0.26",
    "expo-clipboard": "~58.0.4",
    "expo-constants": "~58.0.16",
    "expo-dev-client": "~58.0.21",
    "expo-device": "58.0.5",
    "expo-file-system": "~58.0.14",
    "expo-font": "~58.0.12",
    "expo-haptics": "~58.0.8",
    "expo-intent-launcher": "~58.0.3",
    "expo-secure-store": "~58.0.3",
    "expo-sharing": "~58.0.23",
    "expo-sqlite": "~58.0.18",
    "expo-status-bar": "~58.0.5",
    "nativewind": "4.2.7",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-qrcode-svg": "^6.3.54",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1",
    "react-native-svg": "15.16.0",
    "react-native-worklets": "0.13.0"
  },
  "jest": {
    "testEnvironment": "node",
    "transform": {
      "^.+\\.[jt]sx?$": "babel-jest"
    }
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/jest": "^30.0.0",
    "@types/react": "19.3.0",
    "eslint": "9.37.0",
    "eslint-config-expo": "58.0.4",
    "jest": "~30.5.2",
    "jest-expo": "~58.0.15",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  }
}
