{
  "name": "sg-autoservice",
  "version": "1.0.0",
  "private": true,
  "main": "index.ts",
  "scripts": {
    "start": "expo start",
    "android": "expo start --android",
    "ios": "expo start --ios",
    "lint": "eslint .",
    "format": "prettier --check \"**/*.{ts,tsx,js,json,md}\"",
    "format:write": "prettier --write \"**/*.{ts,tsx,js,json,md}\"",
    "typecheck": "tsc --noEmit",
    "test": "jest",
    "api:types": "npx --yes openapi-typescript@7.13.0 src/api/openapi.json -o src/api/schema.d.ts",
    "theme:sync": "node scripts/sync-theme.mjs",
    "theme:check": "node scripts/sync-theme.mjs --check",
    "export:android": "expo export --platform android"
  },
  "dependencies": {
    "@react-native-async-storage/async-storage": "2.2.0",
    "@react-navigation/bottom-tabs": "7.21.0",
    "@react-navigation/native": "7.5.1",
    "@react-navigation/native-stack": "7.21.0",
    "@tanstack/react-query": "5.106.1",
    "expo": "58.0.23",
    "expo-constants": "58.0.15",
    "expo-device": "58.0.5",
    "expo-secure-store": "58.0.2",
    "expo-status-bar": "58.0.4",
    "nativewind": "4.2.7",
    "openapi-fetch": "0.17.0",
    "react": "19.3.0",
    "react-native": "0.88.1",
    "react-native-reanimated": "4.7.1",
    "react-native-safe-area-context": "5.11.1",
    "react-native-screens": "4.30.1"
  },
  "devDependencies": {
    "@testing-library/react-native": "14.1.0",
    "@types/react": "19.3.0",
    "eslint": "9.37.0",
    "eslint-config-expo": "58.0.4",
    "jest": "30.2.0",
    "jest-expo": "58.0.14",
    "prettier": "3.6.2",
    "tailwindcss": "3.4.17",
    "typescript": "6.0.3"
  }
}
