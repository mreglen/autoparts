APP_ENV=development
DATABASE_URL=postgresql://postgres:postgres@127.0.0.1:5432/autoparts
SECRET_KEY=replace-with-a-long-random-secret
ACCESS_TOKEN_EXPIRE_MINUTES=30
REFRESH_TOKEN_EXPIRE_DAYS=14
EMAIL_HOST=smtp.example.com
EMAIL_PORT=587
EMAIL_HOST_USER=notifications@example.com
EMAIL_HOST_PASSWORD=replace-with-email-password
EMAIL_FROM=notifications@example.com
VERIFICATION_CODE_EXPIRE_SECONDS=600

# Rossko API keys (optional — можно указать в /admin/rossko)
# ROSSKO_KEY1=replace-with-rossko-key
# ROSSKO_KEY2=replace-with-rossko-key
# Официальные SOAP-эндпоинты Rossko (не example.com)
GET_SEARCH=http://api.rossko.ru/service/v2.1/GetSearch
GET_CHECK_OUT_DETAILS=http://api.rossko.ru/service/v2.1/GetCheckoutDetails
GET_CHECK_OUT=http://api.rossko.ru/service/v2.1/GetCheckout
GET_ORDERS=http://api.rossko.ru/service/v2.1/GetOrders
GET_DELIVERY_DETAILS=http://api.rossko.ru/service/v2.1/GetDeliveryDetails
GET_SETTLEMETNS=http://api.rossko.ru/service/v2.1/GetSettlements
GET_BROKEN_WAVE=http://api.rossko.ru/service/v2.1/GetBrokenWave

BASE_URL=http://127.0.0.1:8080
PUBLIC_BASE_URL=http://localhost:3000
CORS_ALLOW_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
REDIS_URL=redis://127.0.0.1:6379/0
CELERY_BROKER_URL=redis://127.0.0.1:6379/0
CELERY_RESULT_BACKEND=redis://127.0.0.1:6379/0

FFMPEG_PATH=ffmpeg
FFPROBE_PATH=ffprobe
API_DOCS_ENABLED=true
TRUSTED_PROXY_HOSTS=127.0.0.1,::1
PRERENDER_INTERNAL_TOKEN=replace-with-a-random-internal-token
AVITO_WEBHOOK_SECRET=replace-with-a-random-webhook-secret

VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
YOOKASSA_SHOP_ID=
YOOKASSA_SECRET_KEY=
DADATA_API_KEY=
