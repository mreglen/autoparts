[Unit]
Description=Autoparts API (Gunicorn + Uvicorn workers)
After=network.target postgresql.service redis-server.service
Wants=postgresql.service redis-server.service

[Service]
Type=simple
User=fast
Group=fast
WorkingDirectory=/home/fast/autoparts/backend
EnvironmentFile=/home/fast/autoparts/backend/.env
ExecStart=/home/fast/autoparts/backend/venv/bin/gunicorn app.main:app \
  -k uvicorn.workers.UvicornWorker \
  -w 2 \
  -b 127.0.0.1:8080 \
  --timeout 120 \
  --graceful-timeout 30 \
  --max-requests 500 \
  --max-requests-jitter 50 \
  --forwarded-allow-ips 127.0.0.1
Restart=on-failure
RestartSec=5

[Install]
WantedBy=multi-user.target
