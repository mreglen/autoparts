# /etc/autoparts/monitor.env — опциональные алерты health-monitor.sh
# cp docs/ops/monitor.env.example /etc/autoparts/monitor.env && chmod 600 /etc/autoparts/monitor.env

# Telegram (опционально). Без токена алерты только в /var/log/autoparts-alerts.log
# TELEGRAM_BOT_TOKEN=
# TELEGRAM_CHAT_ID=

# Пороги (значения по умолчанию совпадают со скриптом)
# WINDOW_MIN=5
# MAX_502_504=5
# MAX_KROAN_RESTARTS=2
# KROAN_RESTART_WINDOW_MIN=15
# LOAD_WARN=4
# RAM_WARN_PCT=90
# DISK_WARN_PCT=90
# ALERT_COOLDOWN_MIN=30
