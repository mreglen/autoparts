# ==============================================================================
# Секреты nginx — НЕ коммитить с реальным токеном.
# Скопировать на сервер: /etc/nginx/snippets/svoygarage-secrets.conf
# chmod 600, владелец root
#
# Значение должно совпадать с PRERENDER_INTERNAL_TOKEN в backend/.env
# ==============================================================================

map $host $sg_prerender_token {
    default "CHANGE_ME_TO_RANDOM_SECRET";
}
